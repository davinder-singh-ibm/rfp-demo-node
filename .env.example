PORT=3000

# API Authentication
# Set API_KEY to enable API key validation
# If not set, any non-empty x-api-key header will be accepted (dev mode)
API_KEY=your-secure-api-key-here

AZURE_STORAGE_CONNECTION_STRING="YOUR_BLOB_CONNECTION_STRING"
BLOB_CONTAINER_INCOMING="incoming-rfps"
BLOB_CONTAINER_OUTPUT="generated-proposals"
BLOB_CONTAINER_PAST="past-proposals"

AZURE_SEARCH_ENDPOINT="https://YOURSEARCH.search.windows.net"
AZURE_SEARCH_API_KEY="YOUR_SEARCH_ADMIN_KEY"
AZURE_SEARCH_INDEX_NAME="past-proposals-index"

AZURE_OPENAI_ENDPOINT="https://YOUR_OPENAI_RESOURCE.openai.azure.com"
AZURE_OPENAI_API_KEY="YOUR_AZURE_OPENAI_KEY"
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
AZURE_OPENAI_API_VERSION="2024-06-01"

# Authentication settings
DISABLE_ENTRA_AUTH=false
API_KEY="demo-mcp-key"

# When DISABLE_ENTRA_AUTH=false, API requires x-api-key header for authentication
# This is used for MCP server integration and API access control